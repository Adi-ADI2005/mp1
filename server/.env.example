# Local demo mode is for development only. Production must use MongoDB and HTTPS.
DEMO_MODE=true
ALLOW_DEMO_AUTH=true
ENVIRONMENT=development
BACKEND_PORT=8000
MODEL_PROVIDER=demo
DATABASE_NAME=fish_monitoring
MAX_UPLOAD_SIZE=10485760
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://localhost:5173,http://127.0.0.1:5173
UPLOAD_DIR=uploads
MODEL_DIR=ml/models

# Configure only on the backend; never copy this into client/.env.
# Keep MONGODB_URL in Replit Secrets (or a private local server/.env file).
# URL-encode reserved characters in the username or password.
# MONGODB_URL=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority

# Generate a long random secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET=replace_with_a_long_random_secret

# Optional initial administrator; set both only when bootstrapping a new deployment.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=replace_with_a_unique_strong_password

# Optional model path for the real fish detector provider.
# FISH_DETECTION_MODEL=server/ml/models/detection/fish_detection.pt